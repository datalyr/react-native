{
  "name": "@datalyr/react-native",
  "version": "1.8.0",
  "description": "DATALYR SDK for React Native and Expo: attribution and event tracking for iOS and Android apps",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest --forceExit",
    "lint": "eslint src --ext .ts,.tsx",
    "validate:ios": "bash scripts/validate-ios.sh",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "lib/",
    "src/",
    "ios/",
    "android/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "*.podspec",
    "expo-module.config.json",
    "app.plugin.js"
  ],
  "keywords": [
    "react-native",
    "expo",
    "skadnetwork",
    "attribution",
    "tracking",
    "mobile",
    "datalyr",
    "session-tracking",
    "utm-tracking",
    "server-side-attribution",
    "ios-attribution",
    "android-attribution",
    "apple-search-ads",
    "play-install-referrer",
    "gclid",
    "conversion-tracking",
    "fbclid",
    "ttclid"
  ],
  "author": "Datalyr",
  "license": "MIT",
  "homepage": "https://docs.datalyr.com/sdk-reference/react-native",
  "bugs": {
    "url": "https://github.com/datalyr/react-native/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datalyr/react-native.git"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=9.0.0",
    "@react-native-async-storage/async-storage": "^2.0.0",
    "@react-native-community/netinfo": ">=11.0.0",
    "expo": ">=52.0.0",
    "expo-application": ">=6.0.0",
    "expo-device": ">=7.0.0",
    "expo-modules-core": ">=2.0.0",
    "expo-network": ">=7.0.0",
    "expo-router": ">=4.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-device-info": ">=12.0.0",
    "react-native-get-random-values": "^1.8.0"
  },
  "dependencies": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.8",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "expo-modules-core": "^3.0.29",
    "jest": "^30.0.0",
    "react": "^18.2.0",
    "react-native-get-random-values": "^1.11.0",
    "typescript": "^5.7.0"
  },
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./expo": {
      "react-native": "./src/expo.ts",
      "default": "./lib/expo.js"
    }
  },
  "peerDependenciesMeta": {
    "expo-modules-core": {
      "optional": false
    },
    "expo": {
      "optional": true
    },
    "@expo/config-plugins": {
      "optional": true
    },
    "expo-device": {
      "optional": true
    },
    "expo-application": {
      "optional": true
    },
    "expo-network": {
      "optional": true
    },
    "react-native-device-info": {
      "optional": true
    },
    "@react-native-community/netinfo": {
      "optional": true
    },
    "expo-router": {
      "optional": true
    }
  }
}
